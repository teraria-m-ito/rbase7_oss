<div class="form-group form-inline input-group-sm align-items-start">
  <%= form.input :locale, as: :select, collection: Translation.locale_options, input_html: {col: 2} %>
  <%= form.input :key, input_html: {col: 5} %>
</div>
<div class="form-group form-inline input-group-sm align-items-start">
  <%= form.input :value, as: :text, input_html: {col: 8, rows: 6, value: form.object.raw_value} %>
</div>
<div class="form-group form-inline input-group-sm align-items-start">
  <%= form.input :scope, as: :select, collection: Translation.scope_options(@sites), include_blank: true, input_html: {col: 4} %>
  <%= form.input :is_proc %>
</div>
